{
  "name": "linha-viva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --host 0.0.0.0 --strictPort --mode demo",
    "build:demo": "vite build --mode demo && vite build --ssr src/demo/standalone.ts --outDir dist-server",
    "start:demo": "node dist-server/standalone.js",
    "demo:internet": "npm run build:demo && node scripts/demo-internet.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src e2e scripts vite.config.ts playwright.config.ts",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "test:db:supabase": "supabase test db",
    "test:load": "node scripts/load-test.mjs",
    "format": "prettier --write src e2e scripts index.html vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src e2e scripts index.html vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgtap": "^0.0.9",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "supabase": "^2.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "ws": "^8.21.3"
  }
}
